    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node tools/test.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "esbuild": "0.24.2",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.6.0",
    "obsidian": "1.14.4",
    "perfect-freehand": "1.2.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  }
}
