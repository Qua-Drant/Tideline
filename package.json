{
  "name": "tideline",
  "version": "0.9.7",
  "private": true,
  "description": "Tideline (潮线): a hand-drawn nautical sketchbook for Obsidian — today, planning, tasks, projects, review, library and a knowledge map.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "watch": "node tools/build.mjs --watch",
